# =============================================================================
# Halvion - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# All services and Prisma CLI commands read from this single root .env file.
# =============================================================================

# ---------------------- Infrastructure (shared) ----------------------
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
REDIS_URL="redis://localhost:6379"

# ---------------------- Core Service (Port 3001) ----------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/CORE?schema=public"
JWT_SECRET="your-super-secret-jwt-key-change-in-production-must-be-at-least-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
CORE_PORT=3001

# ---------------------- Venue Service (Port 3003) ----------------------
DATABASE_VENUE_URL="postgresql://postgres:password@localhost:5432/VENUE?schema=public"
VENUE_PORT=3003

# ---------------------- Booking Service (Port 3002) ----------------------
DATABASE_BOOKING_URL="postgresql://postgres:password@localhost:5432/BOOKING?schema=public"
BOOKING_PORT=3002

# ---------------------- Payment Service (Port 3004) ----------------------
DATABASE_PAYMENT_URL="postgresql://postgres:password@localhost:5432/PAYMENT?schema=public"
PAYMENT_PORT=3004

# ---------------------- Logging (shared across all services) ----------------------
LOGGING_DATABASE_URL="postgresql://postgres:password@localhost:5432/LOGGING?schema=public"
