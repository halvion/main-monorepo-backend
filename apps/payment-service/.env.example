# Payment Service
# This is an example file - copy to .env and fill in values

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/payment_db?schema=public"
LOGGING_DATABASE_URL="postgresql://postgres:password@localhost:5432/logging_db?schema=public"

# JWT (same secret as core-service for token verification)
JWT_SECRET="same-secret-as-core-service"

# Service
PORT=3004

# RabbitMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Redis
REDIS_URL="redis://localhost:6379"

# Payment Provider (Stripe/etc)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
