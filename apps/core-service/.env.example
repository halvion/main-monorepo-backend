# Core Service (IAM/Auth)
# This is an example file - copy to .env and fill in values

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/core_db?schema=public"
LOGGING_DATABASE_URL="postgresql://postgres:password@localhost:5432/logging_db?schema=public"

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-64-char-min-secret-here-generate-with-command-above"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Service
PORT=3001

# RabbitMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Redis
REDIS_URL="redis://localhost:6379"

# CORS (comma-separated origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4200"
