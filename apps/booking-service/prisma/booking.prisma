// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/booking-prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id           String        @id @default(uuid())
  userId       String        // Ref to CORE
  totalAmount  Decimal       @db.Decimal(12, 2)
  status       BookingStatus @default(PENDING)
  bookingMode  BookingMode   @default(TRADITIONAL)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  items        BookingItem[]
  logs         BookingLog[]
  
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PAYMENT_PENDING
  PAID
  CANCELLED
  REFUNDED
  EXPIRED
}

enum BookingMode {
  TRADITIONAL
  REDLOCK
}


model BookingItem {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  facilityId  String   // Ref to VENUE
  slotDate    DateTime @db.Date
  startTime   String   // "10:00"
  endTime     String   // "12:00"
  price       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  
  slot        SlotInventory?
  
  @@map("booking_items")
}

// Key table for Concurrency Control (Redis + DB)
model SlotInventory {
  id            String       @id @default(uuid())
  facilityId    String       // Ref to VENUE
  slotDate      DateTime     @db.Date
  startTime     String
  endTime       String
  isAvailable   Boolean      @default(true)
  bookingItemId String?      @unique
  bookingItem   BookingItem? @relation(fields: [bookingItemId], references: [id])
  lockedAt      DateTime?
  lockedBy      String?      // userId who has temporary lock
  
  @@unique([facilityId, slotDate, startTime])
  @@map("slot_inventory")
}

// Saga Monitoring / Audit Trail
model BookingLog {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  action     String   // CREATED, PAYMENT_INITIATED, PAID, CANCELLED, ROLLBACK
  actor      String?  // userId or "SYSTEM"
  metadata   Json?    // Additional context
  createdAt  DateTime @default(now())
  
  @@map("booking_logs")
}
